{
  "hosting": [
    {
      "target": "staging",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**/*.@(js|css|svg|woff2|webp|jpg|png)",
          "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "prod",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**/*.@(js|css|svg|woff2|webp|jpg|png)",
          "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
        }
      ]
    }
  ]
}
