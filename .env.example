# Frontend env — safe to bundle (VITE_ prefix is exposed to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Stripe key (publishable — safe in client)
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloud Functions base URL (set after first deploy, e.g. https://us-central1-booklypro.cloudfunctions.net)
VITE_FUNCTIONS_URL=

# Sentry (browser DSN — optional)
VITE_SENTRY_DSN=

# PostHog (browser key — optional)
VITE_POSTHOG_KEY=

# Anything secret goes in functions/.env, NOT here.
